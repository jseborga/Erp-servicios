<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_l10n_bo_purchase" model="res.groups.privilege">
        <field name="name">Compras (Bolivia)</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="res_groups_privilege_l10n_bo_fiscal" model="res.groups.privilege">
        <field name="name">Fiscal (Bolivia)</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_spa_buyer" model="res.groups">
        <field name="name">Comprador</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_l10n_bo_purchase"/>
        <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        <field name="comment">Crea solicitudes y órdenes de compra. La aprobación por monto usa la doble validación estándar de Compras.</field>
    </record>

    <record id="group_spa_accountant" model="res.groups">
        <field name="name">Contador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_l10n_bo_fiscal"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Valida documentos fiscales de compra (facturas, retenciones), el Libro de Compras y aprueba las rendiciones de fondo fijo.</field>
    </record>

    <record id="l10n_bo_purchase_book_company_rule" model="ir.rule">
        <field name="name">Libro de Compras: multiempresa</field>
        <field name="model_id" ref="model_l10n_bo_purchase_book"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
