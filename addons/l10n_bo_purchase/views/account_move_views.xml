<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_bo_purchase" model="ir.ui.view">
        <field name="name">account.move.form.l10n_bo_purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_bo_open_qr_wizard" type="object" string="Leer QR"
                        icon="fa-qrcode"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or country_code != 'BO'"/>
                <button name="action_l10n_bo_apply_withholding" type="object" string="Aplicar retenciones"
                        invisible="state != 'draft' or l10n_bo_doc_type != 'none' or not l10n_bo_withholding_mode"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not l10n_bo_duplicate_warning">
                    <field name="l10n_bo_duplicate_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/.." position="after">
                <group name="l10n_bo_fiscal_document" string="Documento fiscal (SIN)"
                       invisible="move_type not in ('in_invoice', 'in_refund') or country_code != 'BO'">
                    <group>
                        <field name="l10n_bo_doc_type"
                               required="move_type == 'in_invoice' and country_code == 'BO'"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_supplier_nit"
                               invisible="not l10n_bo_doc_type"
                               required="l10n_bo_has_invoice"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_invoice_number"
                               invisible="not l10n_bo_has_invoice"
                               required="l10n_bo_has_invoice"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_cuf"
                               invisible="l10n_bo_doc_type != 'siat_online'"
                               required="l10n_bo_doc_type == 'siat_online'"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_auth_number"
                               invisible="l10n_bo_doc_type not in ('dosificacion', 'manual')"
                               required="l10n_bo_doc_type in ('dosificacion', 'manual')"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_control_code"
                               invisible="l10n_bo_doc_type != 'dosificacion'"
                               required="l10n_bo_doc_type == 'dosificacion'"
                               readonly="state != 'draft'"
                               placeholder="7B-F3-48-A8"/>
                    </group>
                    <group>
                        <field name="l10n_bo_purchase_type"
                               invisible="not l10n_bo_has_invoice"
                               required="l10n_bo_has_invoice and move_type == 'in_invoice'"/>
                        <field name="l10n_bo_withholding_mode"
                               invisible="l10n_bo_doc_type != 'none'"
                               required="l10n_bo_doc_type == 'none'"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_purchase_kind"
                               invisible="l10n_bo_doc_type != 'none' or l10n_bo_withholding_mode not in ('supplier_bears', 'company_bears')"
                               readonly="state != 'draft'"/>
                        <field name="l10n_bo_has_invoice" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="before">
                <field name="l10n_bo_purchase_kind" optional="hide"
                       column_invisible="parent.l10n_bo_doc_type != 'none' or parent.l10n_bo_withholding_mode not in ('supplier_bears', 'company_bears')"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_l10n_bo_purchase" model="ir.ui.view">
        <field name="name">account.move.list.l10n_bo_purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="l10n_bo_doc_type" optional="show"/>
                <field name="l10n_bo_supplier_nit" optional="hide"/>
                <field name="l10n_bo_invoice_number" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_l10n_bo_purchase" model="ir.ui.view">
        <field name="name">account.move.search.l10n_bo_purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_bo_supplier_nit"/>
                <field name="l10n_bo_invoice_number"/>
                <field name="l10n_bo_doc_key"/>
            </field>
        </field>
    </record>
</odoo>
