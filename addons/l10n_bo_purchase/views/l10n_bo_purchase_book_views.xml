<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_bo_purchase_book_view_list" model="ir.ui.view">
        <field name="name">l10n_bo.purchase.book.list</field>
        <field name="model">l10n_bo.purchase.book</field>
        <field name="arch" type="xml">
            <list string="Libro de Compras" create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="specification" optional="hide"/>
                <field name="date"/>
                <field name="supplier_nit"/>
                <field name="supplier_name"/>
                <field name="auth_number"/>
                <field name="invoice_number"/>
                <field name="dui_dim" optional="hide"/>
                <field name="control_code"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_ice" optional="hide" sum="Total"/>
                <field name="amount_iehd" optional="hide" sum="Total"/>
                <field name="amount_ipj" optional="hide" sum="Total"/>
                <field name="amount_fees" optional="hide" sum="Total"/>
                <field name="amount_not_subject" optional="show" sum="Total"/>
                <field name="amount_exempt" optional="show" sum="Total"/>
                <field name="amount_zero_rate" optional="hide" sum="Total"/>
                <field name="amount_subtotal" sum="Total"/>
                <field name="amount_discount" optional="hide" sum="Total"/>
                <field name="amount_gift_card" optional="hide" sum="Total"/>
                <field name="amount_base" sum="Total"/>
                <field name="amount_credit" sum="Total"/>
                <field name="purchase_type"/>
                <field name="doc_type" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_move" type="object" icon="fa-external-link" title="Ver factura"/>
            </list>
        </field>
    </record>

    <record id="l10n_bo_purchase_book_view_pivot" model="ir.ui.view">
        <field name="name">l10n_bo.purchase.book.pivot</field>
        <field name="model">l10n_bo.purchase.book</field>
        <field name="arch" type="xml">
            <pivot string="Libro de Compras">
                <field name="period" type="row"/>
                <field name="amount_total" type="measure"/>
                <field name="amount_base" type="measure"/>
                <field name="amount_credit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="l10n_bo_purchase_book_view_search" model="ir.ui.view">
        <field name="name">l10n_bo.purchase.book.search</field>
        <field name="model">l10n_bo.purchase.book</field>
        <field name="arch" type="xml">
            <search string="Libro de Compras">
                <field name="supplier_nit"/>
                <field name="supplier_name"/>
                <field name="invoice_number"/>
                <field name="period"/>
                <filter name="filter_date" string="Fecha" date="date"/>
                <separator/>
                <filter name="siat_online" string="En línea (CUF)" domain="[('doc_type', '=', 'siat_online')]"/>
                <filter name="dosificacion" string="Computarizadas" domain="[('doc_type', '=', 'dosificacion')]"/>
                <filter name="manual" string="Manuales" domain="[('doc_type', '=', 'manual')]"/>
                <group>
                    <filter name="group_period" string="Período" context="{'group_by': 'period'}"/>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_purchase_type" string="Tipo de compra" context="{'group_by': 'purchase_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_bo_purchase_book_action" model="ir.actions.act_window">
        <field name="name">Libro de Compras</field>
        <field name="res_model">l10n_bo.purchase.book</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="l10n_bo_purchase_book_view_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay facturas de compra publicadas en el período</p>
            <p>Lista las facturas de proveedor publicadas con documento fiscal (en línea, computarizadas y manuales),
               con base y crédito fiscal del 13 %. Filtre por mes y use <b>Exportar</b> para obtener el archivo.
               El orden y formato oficial del Registro de Compras del SIAT deben verificarse con la normativa vigente.</p>
        </field>
    </record>
</odoo>
