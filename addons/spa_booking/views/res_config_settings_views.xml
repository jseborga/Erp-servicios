<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_spa_booking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spa.booking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="spa_base.res_config_settings_view_form_spa"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='spa_general']" position="after">
                <block title="Reservas" name="spa_booking">
                    <setting string="Lista de espera" help="Minutos que se guarda el cupo liberado a la primera persona avisada de la lista de espera (0 = sin guardar).">
                        <field name="spa_waitlist_priority_minutes"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
