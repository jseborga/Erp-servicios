<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_membership_view_list" model="ir.ui.view">
        <field name="name">spa.membership.list</field>
        <field name="model">spa.membership</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'cancelled')" decoration-warning="state == 'grace'" decoration-danger="state == 'suspended'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone" optional="show"/>
                <field name="plan_id"/>
                <field name="period_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'grace'" decoration-danger="state == 'suspended'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="spa_membership_view_form" model="ir.ui.view">
        <field name="name">spa.membership.form</field>
        <field name="model">spa.membership</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activar" class="btn-primary"
                            invisible="state not in ('draft', 'expired')" groups="spa_base.group_spa_manager"/>
                    <button name="action_suspend" type="object" string="Suspender"
                            invisible="state not in ('active', 'grace')" groups="spa_base.group_spa_manager"/>
                    <button name="action_open_adjust_wizard" type="object" string="Ajustar saldo"
                            invisible="state not in ('active', 'grace')" groups="spa_base.group_spa_manager"/>
                    <button name="action_open_freeze_wizard" type="object" string="Congelar"
                            invisible="state != 'active' or freeze_max_days &lt;= 0" groups="spa_base.group_spa_manager"/>
                    <button name="action_cancel" type="object" string="Cancelar membresía"
                            invisible="state in ('cancelled', 'expired')" groups="spa_base.group_spa_manager"
                            confirm="¿Cancelar esta membresía? El socio pierde el acceso."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,grace,suspended"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Congelada" bg_color="text-bg-info" invisible="not frozen_until"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Socio">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="Plan">
                            <field name="plan_id" readonly="state != 'draft'"/>
                            <field name="period_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="price"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="grace_until" invisible="state != 'grace'"/>
                            <field name="frozen_until" invisible="not frozen_until"/>
                            <field name="freeze_max_days" invisible="1"/>
                            <field name="guests_this_month"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Saldos" name="balances">
                            <field name="entitlement_ids" readonly="1">
                                <list decoration-muted="remaining == 0 and not unlimited">
                                    <field name="period_start" string="Mes"/>
                                    <field name="service_id"/>
                                    <field name="unlimited"/>
                                    <field name="granted"/>
                                    <field name="carried_in"/>
                                    <field name="used"/>
                                    <field name="remaining"/>
                                </list>
                            </field>
                        </page>
                        <page string="Libro de consumos" name="consumption">
                            <field name="consumption_ids" readonly="1">
                                <list>
                                    <field name="service_date"/>
                                    <field name="service_id"/>
                                    <field name="qty"/>
                                    <field name="reason"/>
                                    <field name="note"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invitados" name="guests">
                            <field name="guest_ids" context="{'default_membership_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="service_id"/>
                                    <field name="charge_type"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Congelamientos" name="freezes" invisible="not freeze_ids">
                            <field name="freeze_ids" readonly="1">
                                <list decoration-muted="state == 'cancelled'">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="days" sum="Días"/>
                                    <field name="reason"/>
                                    <field name="date_end_before"/>
                                    <field name="user_id"/>
                                    <field name="state" widget="badge" decoration-info="state == 'active'"/>
                                    <button name="action_cancel" type="object" string="Anular" class="btn-link"
                                            invisible="state != 'active'" groups="spa_base.group_spa_manager"
                                            confirm="¿Anular el congelamiento? El vencimiento vuelve a la fecha anterior."/>
                                </list>
                            </field>
                        </page>
                        <page string="Credencial y notas" name="notes">
                            <group>
                                <field name="qr_token" groups="spa_base.group_spa_manager"/>
                                <field name="note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="spa_membership_view_search" model="ir.ui.view">
        <field name="name">spa.membership.search</field>
        <field name="model">spa.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="plan_id"/>
                <filter name="live" string="Vigentes" domain="[('state', 'in', ('active', 'grace'))]"/>
                <filter name="grace" string="En gracia" domain="[('state', '=', 'grace')]"/>
                <filter name="suspended" string="Suspendidas" domain="[('state', '=', 'suspended')]"/>
                <filter name="draft" string="Por activar" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="ends_soon" string="Vencen en 7 días"
                        domain="[('state', '=', 'active'), ('date_end', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="spa_membership_action" model="ir.actions.act_window">
        <field name="name">Membresías</field>
        <field name="res_model">spa.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registre la primera membresía</p>
            <p>Elija el socio, el plan y la duración. Al activarla se crean sus saldos del mes.</p>
        </field>
    </record>

    <record id="spa_consumption_view_list" model="ir.ui.view">
        <field name="name">spa.consumption.list</field>
        <field name="model">spa.consumption</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="service_date"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="service_id"/>
                <field name="qty" sum="Total"/>
                <field name="reason"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="spa_consumption_view_pivot" model="ir.ui.view">
        <field name="name">spa.consumption.pivot</field>
        <field name="model">spa.consumption</field>
        <field name="arch" type="xml">
            <pivot string="Uso por plan">
                <field name="plan_id" type="row"/>
                <field name="service_id" type="col"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="spa_consumption_action" model="ir.actions.act_window">
        <field name="name">Libro de consumos</field>
        <field name="res_model">spa.consumption</field>
        <field name="view_mode">list,pivot</field>
    </record>
</odoo>
