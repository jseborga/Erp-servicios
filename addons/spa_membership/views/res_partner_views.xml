<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_spa" model="ir.ui.view">
        <field name="name">res.partner.form.spa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_spa_memberships" type="object" class="oe_stat_button" icon="fa-id-card"
                        groups="spa_base.group_spa_reception" invisible="not spa_membership_count">
                    <field name="spa_membership_count" widget="statinfo" string="Membresías"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
