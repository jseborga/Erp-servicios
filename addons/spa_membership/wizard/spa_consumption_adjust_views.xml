<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_consumption_adjust_view_form" model="ir.ui.view">
        <field name="name">spa.consumption.adjust.form</field>
        <field name="model">spa.consumption.adjust</field>
        <field name="arch" type="xml">
            <form string="Ajustar saldo">
                <group>
                    <field name="membership_id" readonly="1"/>
                    <field name="allowed_service_ids" invisible="1"/>
                    <field name="service_id" options="{'no_create': True}"/>
                    <field name="qty"/>
                    <field name="reason" placeholder="Ej. Cortesía por mantenimiento de la piscina"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Registrar ajuste" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
