<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Mensajes con celular y texto (datos personales): cada empresa ve los suyos. -->
        <record id="spa_message_company_rule" model="ir.rule">
            <field name="name">Mensajes de WhatsApp: multiempresa</field>
            <field name="model_id" ref="model_spa_message"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
