<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_spa_messaging" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spa.messaging</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="spa_base.res_config_settings_view_form_spa"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='spa_general']" position="after">
                <block title="WhatsApp" name="spa_whatsapp">
                    <setting string="Proveedor" help="Enlace wa.me: recepción envía desde la app normal. API oficial: envío automático (requiere cuenta de WhatsApp Business Platform).">
                        <field name="spa_messaging_provider"/>
                        <div class="mt-2">
                            <label for="spa_messaging_country_code" class="me-2"/>
                            <field name="spa_messaging_country_code" class="oe_inline"/>
                        </div>
                    </setting>
                    <setting string="API oficial de Meta" invisible="spa_messaging_provider != 'meta_cloud'"
                             help="Datos de la app en developers.facebook.com.">
                        <div><label for="spa_messaging_meta_phone_id" class="me-2"/><field name="spa_messaging_meta_phone_id"/></div>
                        <div><label for="spa_messaging_meta_token" class="me-2"/><field name="spa_messaging_meta_token" password="True"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
