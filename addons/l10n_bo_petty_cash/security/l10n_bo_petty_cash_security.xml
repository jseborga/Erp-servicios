<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_petty_cash" model="res.groups.privilege">
        <field name="name">Fondo fijo (caja chica)</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_petty_cash_custodian" model="res.groups">
        <field name="name">Custodio</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_petty_cash"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Registra los gastos de su fondo con foto del comprobante y envía la rendición con el arqueo. Solo ve su fondo.</field>
    </record>

    <!-- Multiempresa -->
    <record id="petty_cash_fund_company_rule" model="ir.rule">
        <field name="name">Fondo fijo: multiempresa</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_fund"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="petty_cash_voucher_company_rule" model="ir.rule">
        <field name="name">Comprobante de fondo fijo: multiempresa</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="petty_cash_report_company_rule" model="ir.rule">
        <field name="name">Rendición de fondo fijo: multiempresa</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- El custodio solo ve su fondo -->
    <record id="petty_cash_fund_custodian_rule" model="ir.rule">
        <field name="name">Fondo fijo: solo el del custodio</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_fund"/>
        <field name="domain_force">[('custodian_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_custodian'))]"/>
    </record>
    <record id="petty_cash_voucher_custodian_rule" model="ir.rule">
        <field name="name">Comprobante de fondo fijo: solo del fondo del custodio</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_voucher"/>
        <field name="domain_force">[('fund_id.custodian_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_custodian'))]"/>
    </record>
    <record id="petty_cash_report_custodian_rule" model="ir.rule">
        <field name="name">Rendición de fondo fijo: solo del fondo del custodio</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_report"/>
        <field name="domain_force">[('fund_id.custodian_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_petty_cash_custodian'))]"/>
    </record>

    <!-- El contador ve todos los fondos de sus compañías -->
    <record id="petty_cash_fund_accountant_rule" model="ir.rule">
        <field name="name">Fondo fijo: contador</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_fund"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('l10n_bo_purchase.group_spa_accountant'))]"/>
    </record>
    <record id="petty_cash_voucher_accountant_rule" model="ir.rule">
        <field name="name">Comprobante de fondo fijo: contador</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_voucher"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('l10n_bo_purchase.group_spa_accountant'))]"/>
    </record>
    <record id="petty_cash_report_accountant_rule" model="ir.rule">
        <field name="name">Rendición de fondo fijo: contador</field>
        <field name="model_id" ref="model_l10n_bo_petty_cash_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('l10n_bo_purchase.group_spa_accountant'))]"/>
    </record>
</odoo>
