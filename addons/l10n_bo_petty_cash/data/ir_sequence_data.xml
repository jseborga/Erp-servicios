<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_petty_cash_voucher" model="ir.sequence">
        <field name="name">Comprobantes de fondo fijo</field>
        <field name="code">l10n_bo.petty.cash.voucher</field>
        <field name="prefix">VFF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_petty_cash_report" model="ir.sequence">
        <field name="name">Rendiciones de fondo fijo</field>
        <field name="code">l10n_bo.petty.cash.report</field>
        <field name="prefix">RFF/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
