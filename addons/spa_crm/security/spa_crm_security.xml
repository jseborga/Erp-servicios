<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- docs/10: Recepción = «CRM usuario» (sus prospectos y los sin asignar, p. ej. «Pasó por recepción»).
         Marketing = «CRM gerente»: todos los prospectos, fuentes, embudos y etapas. -->
    <record id="spa_base.group_spa_reception" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="spa_base.group_spa_marketing" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="spa_base.group_spa_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <data noupdate="1">
        <record id="spa_courtesy_pass_company_rule" model="ir.rule">
            <field name="name">Pases de cortesía: multiempresa</field>
            <field name="model_id" ref="model_spa_courtesy_pass"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
