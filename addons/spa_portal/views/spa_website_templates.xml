<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Detalle compacto de lo que incluye un plan (tarjeta y página del plan) -->
    <template id="spa_plan_lines" name="Spa: servicios del plan">
        <ul class="list-unstyled mb-0">
            <li t-foreach="lines" t-as="line" class="d-flex gap-2 mb-2">
                <i class="fa fa-check text-success mt-1" aria-hidden="true"/>
                <span>
                    <strong t-out="line['name']"/>
                    <span class="text-muted">· <t t-out="line['summary']"/></span>
                    <small t-if="line['guests']" class="d-block text-muted">
                        Hasta <t t-out="line['guests']"/> invitado(s) por visita
                    </small>
                </span>
            </li>
            <li t-if="plan.guest_quota" class="d-flex gap-2 mb-2">
                <i class="fa fa-ticket text-success mt-1" aria-hidden="true"/>
                <span><strong t-out="plan.guest_quota"/> free pass para invitados al mes</span>
            </li>
        </ul>
    </template>

    <!-- /spa: catálogo público de planes -->
    <template id="spa_plans" name="Spa: planes de membresía">
        <t t-call="website.layout">
            <t t-set="additional_title">Membresías</t>
            <div id="wrap" class="o_spa_plans">
                <div class="oe_structure" id="oe_structure_spa_plans_top"/>
                <section class="py-4 py-md-5 text-center">
                    <div class="container">
                        <h1 class="display-6 fw-bold mb-2">Membresías</h1>
                        <p class="lead text-muted mb-0">
                            Piscina, sauna, jacuzzi y masajes con tu plan. Te inscribes en línea
                            y pagas con QR o transferencia.
                        </p>
                    </div>
                </section>
                <section class="container pb-5">
                    <div t-if="not cards" class="alert alert-info text-center" role="status">
                        Pronto publicaremos nuestros planes. Escríbenos y te contamos los detalles.
                    </div>
                    <div class="row g-4 justify-content-center">
                        <div t-foreach="cards" t-as="card" class="col-12 col-md-6 col-lg-4">
                            <t t-set="plan" t-value="card['plan']"/>
                            <t t-set="lines" t-value="card['lines']"/>
                            <article t-attf-class="card h-100 shadow-sm o_spa_plan_card #{'border-primary border-2' if card['is_mine'] else ''}">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                        <h2 class="h4 card-title mb-0" t-out="plan.name"/>
                                        <span t-if="card['is_mine']" class="badge text-bg-primary">Tu plan</span>
                                    </div>
                                    <p t-if="plan.min_price" class="mb-3">
                                        <span class="small text-muted">Desde</span>
                                        <span class="fs-3 fw-bold" t-out="money(plan.min_price, plan.currency_id)"/>
                                        <span class="small text-muted">/mes</span>
                                    </p>
                                    <div t-if="not is_html_empty(plan.description)" class="text-muted mb-3" t-out="plan.description"/>
                                    <h3 class="h6 text-uppercase text-muted small">Incluye</h3>
                                    <div class="mb-3">
                                        <t t-call="spa_portal.spa_plan_lines"/>
                                    </div>
                                    <h3 t-if="card['periods']" class="h6 text-uppercase text-muted small">Duración y precio</h3>
                                    <ul t-if="card['periods']" class="list-group list-group-flush mb-3">
                                        <li t-foreach="card['periods']" t-as="period"
                                            class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span>
                                                <t t-out="period.name"/>
                                                <small t-if="period.months &gt; 1" class="d-block text-muted">
                                                    equivale a <t t-out="money(period.monthly_price, plan.currency_id)"/> al mes
                                                </small>
                                            </span>
                                            <strong t-out="money(period.price, plan.currency_id)"/>
                                        </li>
                                    </ul>
                                    <div t-if="card['offers']" class="mb-3">
                                        <div t-foreach="card['offers']" t-as="offer" class="alert alert-success py-2 px-3 mb-2 small">
                                            <i class="fa fa-tag me-1" aria-hidden="true"/>
                                            <strong t-out="offer.name"/>
                                            <span class="text-muted"> · hasta el <t t-out="fmt_date(offer.date_to)"/></span>
                                            <div t-if="offer.description" class="mt-1" t-out="offer.description"/>
                                        </div>
                                    </div>
                                    <div class="mt-auto d-grid gap-2">
                                        <a t-attf-href="/spa/plan/#{plan.id}" class="btn btn-primary">
                                            <t t-if="card['is_mine']">Ver plan</t>
                                            <t t-else="">Elegir este plan</t>
                                        </a>
                                        <a t-if="card['is_mine']" href="/my/spa" class="btn btn-outline-primary">Ir a mi membresía</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                </section>
                <div class="oe_structure" id="oe_structure_spa_plans_bottom"/>
            </div>
        </t>
    </template>

    <!-- /spa/plan/<id>: detalle del plan y alta en línea -->
    <template id="spa_plan_detail" name="Spa: detalle del plan">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="plan.name"/>
            <div id="wrap" class="o_spa_plan_detail">
                <section class="container py-4">
                    <nav aria-label="Ruta">
                        <ol class="breadcrumb mb-3">
                            <li class="breadcrumb-item"><a href="/spa">Membresías</a></li>
                            <li class="breadcrumb-item active" aria-current="page" t-out="plan.name"/>
                        </ol>
                    </nav>
                    <div class="row g-4">
                        <div class="col-12 col-lg-7">
                            <h1 class="display-6 fw-bold mb-2" t-out="plan.name"/>
                            <p t-if="plan.min_price" class="mb-3">
                                <span class="text-muted">Desde</span>
                                <span class="fs-3 fw-bold" t-out="money(plan.min_price, currency)"/>
                                <span class="text-muted">/mes</span>
                            </p>
                            <div t-if="not is_html_empty(plan.description)" class="mb-4" t-out="plan.description"/>
                            <h2 class="h5">Qué incluye</h2>
                            <div class="mb-4">
                                <t t-call="spa_portal.spa_plan_lines"/>
                            </div>
                            <t t-set="policy" t-value="plan.cancel_policy_id"/>
                            <p t-if="policy" class="small text-muted">
                                <i class="fa fa-clock-o me-1" aria-hidden="true"/>
                                Reservas: cancelación sin costo hasta <t t-out="'%g' % policy.free_cancel_hours"/> h antes.
                            </p>
                        </div>
                        <div class="col-12 col-lg-5">
                            <div class="card shadow-sm o_spa_subscribe_card">
                                <div class="card-body">
                                    <h2 class="h5 mb-3">Hazte socio</h2>
                                    <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                                    <div t-if="existing" class="alert alert-info" role="status">
                                        Ya tienes la membresía <strong t-out="existing.plan_id.name"/>
                                        (<span t-field="existing.state"/>).
                                    </div>
                                    <div t-elif="other" class="alert alert-warning" role="status">
                                        Ya tienes la membresía <strong t-out="other.plan_id.name"/>.
                                        Para cambiar de plan comunícate con recepción: te ayudamos con el prorrateo.
                                        <div class="mt-2"><a href="/my/spa" class="alert-link">Ver mi membresía</a></div>
                                    </div>
                                    <p t-if="not options" class="text-muted mb-0">
                                        Este plan aún no tiene precios publicados. Consúltanos en recepción.
                                    </p>
                                    <form t-elif="not other" t-attf-action="/spa/plan/#{plan.id}/subscribe" method="post"
                                          class="o_spa_subscribe_form">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <fieldset t-if="not existing" class="mb-3">
                                            <legend class="form-label fs-6 fw-semibold">Elige la duración</legend>
                                            <div class="list-group">
                                                <label t-foreach="options" t-as="opt"
                                                       class="list-group-item list-group-item-action d-flex gap-3 align-items-center">
                                                    <input class="form-check-input flex-shrink-0 mt-0" type="radio" name="option"
                                                           t-att-value="opt['key']" t-att-checked="'checked' if opt['key'] == selected else None"
                                                           required="required"/>
                                                    <span class="flex-grow-1">
                                                        <span class="fw-semibold" t-out="opt['label']"/>
                                                        <small t-if="opt['note']" class="d-block text-muted" t-out="opt['note']"/>
                                                    </span>
                                                    <strong class="text-nowrap" t-out="money(opt['price'], currency)"/>
                                                </label>
                                            </div>
                                        </fieldset>
                                        <input t-else="" type="hidden" name="option" t-att-value="selected"/>
                                        <div t-if="need_phone and not existing" class="mb-3">
                                            <label for="spa_phone" class="form-label fw-semibold">Celular (WhatsApp)</label>
                                            <input id="spa_phone" type="tel" name="phone" class="form-control" t-att-value="phone"
                                                   inputmode="tel" autocomplete="tel" placeholder="+591 7xxxxxxx" required="required"/>
                                            <div class="form-text">Te avisamos por WhatsApp de tus reservas y pagos.</div>
                                        </div>
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary btn-lg">
                                                <t t-if="existing">Ver mi membresía</t>
                                                <t t-elif="is_public">Continuar</t>
                                                <t t-else="">Hacerme socio</t>
                                            </button>
                                        </div>
                                        <p t-if="not existing" class="small text-muted mt-3 mb-0">
                                            Generamos tu factura y pagas con QR o transferencia subiendo el comprobante.
                                            Tu membresía se activa cuando caja valida el pago.
                                        </p>
                                    </form>
                                    <div t-if="is_public" class="border-top mt-3 pt-3 small">
                                        <p class="mb-2">Para inscribirte necesitas una cuenta.</p>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a t-att-href="login_url" class="btn btn-outline-primary btn-sm">Iniciar sesión</a>
                                            <a t-if="signup_enabled" t-att-href="signup_url" class="btn btn-outline-secondary btn-sm">Crear mi cuenta</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <div class="oe_structure" id="oe_structure_spa_plan_detail_bottom"/>
            </div>
        </t>
    </template>
</odoo>
