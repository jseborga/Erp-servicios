<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_bo_siat" model="ir.ui.view">
        <field name="name">account.move.form.l10n_bo_siat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_bo_siat_open_register" type="object" string="Registrar datos SIAT"
                        class="btn-primary" groups="account.group_account_invoice"
                        invisible="state != 'posted' or l10n_bo_sale_doc != 'siat' or l10n_bo_siat_state not in ('to_send', 'rejected') or l10n_bo_siat_mode != 'portal_web'"/>
                <button name="action_l10n_bo_siat_send" type="object" string="Enviar al SIAT"
                        class="btn-primary" groups="account.group_account_invoice"
                        invisible="state != 'posted' or l10n_bo_sale_doc != 'siat' or l10n_bo_siat_state not in ('to_send', 'rejected') or l10n_bo_siat_mode != 'provider'"/>
                <button name="action_l10n_bo_siat_open_cancel" type="object" string="Anular en SIAT"
                        groups="account.group_account_invoice"
                        invisible="state != 'posted' or l10n_bo_siat_state != 'accepted'"/>
            </xpath>
            <xpath expr="//button[@name='button_request_cancel']" position="attributes">
                <attribute name="invisible">state != 'posted' or show_reset_to_draft_button or not need_cancel_request or l10n_bo_siat_state</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not l10n_bo_siat_simulated">
                    <strong>Documento SIMULADO:</strong> emitido por el simulador SIAT. <b>NO es una factura válida ante el SIN</b>;
                    úselo solo para capacitación y pruebas.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="not l10n_bo_siat_warning"
                     style="white-space: pre-line;">
                    <field name="l10n_bo_siat_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="l10n_bo_sale_user_can_no_invoice" invisible="1"/>
                <field name="l10n_bo_sale_doc"
                       invisible="move_type not in ('out_invoice', 'out_refund') or country_code != 'BO'"
                       required="move_type in ('out_invoice', 'out_refund') and country_code == 'BO'"
                       readonly="state != 'draft' or not l10n_bo_sale_user_can_no_invoice"/>
                <field name="l10n_bo_siat_state" widget="badge"
                       invisible="not l10n_bo_siat_state"
                       decoration-success="l10n_bo_siat_state == 'accepted'"
                       decoration-warning="l10n_bo_siat_state in ('to_send', 'cancel_requested')"
                       decoration-danger="l10n_bo_siat_state in ('rejected', 'cancelled')"
                       decoration-muted="l10n_bo_siat_state == 'not_applicable'"/>
                <field name="l10n_bo_siat_number" invisible="not l10n_bo_siat_number"/>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']" position="after">
                <page id="l10n_bo_siat_tab" name="l10n_bo_siat" string="SIAT (Bolivia)"
                      invisible="move_type not in ('out_invoice', 'out_refund') or country_code != 'BO'">
                    <field name="country_code" invisible="1"/>
                    <field name="l10n_bo_siat_simulated" invisible="1"/>
                    <field name="l10n_bo_siat_cancel_reversal" invisible="1"/>
                    <group>
                        <group string="Comprador" name="l10n_bo_siat_buyer">
                            <field name="l10n_bo_sale_buyer_doc_type"
                                   readonly="l10n_bo_siat_state in ('accepted', 'cancel_requested', 'cancelled')"/>
                            <field name="l10n_bo_sale_buyer_number"
                                   readonly="l10n_bo_siat_state in ('accepted', 'cancel_requested', 'cancelled')"/>
                            <field name="l10n_bo_sale_buyer_complement"
                                   invisible="l10n_bo_sale_buyer_doc_type != '1'"
                                   readonly="l10n_bo_siat_state in ('accepted', 'cancel_requested', 'cancelled')"/>
                            <field name="l10n_bo_sale_buyer_name"
                                   readonly="l10n_bo_siat_state in ('accepted', 'cancel_requested', 'cancelled')"/>
                        </group>
                        <group string="Documento SIAT" name="l10n_bo_siat_document">
                            <field name="l10n_bo_siat_mode" invisible="not l10n_bo_siat_mode"/>
                            <field name="l10n_bo_siat_provider_id" invisible="not l10n_bo_siat_provider_id"/>
                            <field name="l10n_bo_siat_number"/>
                            <field name="l10n_bo_siat_cuf"/>
                            <field name="l10n_bo_siat_emission_date"/>
                            <field name="l10n_bo_siat_attempts" invisible="not l10n_bo_siat_attempts"/>
                        </group>
                    </group>
                    <group string="Venta sin factura" invisible="l10n_bo_sale_doc != 'no_invoice'">
                        <field name="l10n_bo_sale_no_invoice_reason"
                               required="l10n_bo_sale_doc == 'no_invoice' and move_type == 'out_invoice' and state == 'draft'"
                               readonly="state != 'draft'"
                               placeholder="Caso permitido por la norma, confirmado con el contador"/>
                        <field name="l10n_bo_sale_no_invoice_user_id" invisible="not l10n_bo_sale_no_invoice_user_id"/>
                    </group>
                    <group string="Anulación" invisible="not l10n_bo_siat_cancel_reason_id">
                        <field name="l10n_bo_siat_cancel_reason_id"/>
                        <field name="l10n_bo_siat_cancel_note"/>
                        <field name="l10n_bo_siat_cancel_date"/>
                    </group>
                    <div invisible="not l10n_bo_siat_cancel_reversal" class="text-muted">
                        Reversión contable de una factura anulada en el SIAT. No es una nota de crédito-débito fiscal.
                    </div>
                    <separator string="Bitácora SIAT" invisible="not l10n_bo_siat_log"/>
                    <field name="l10n_bo_siat_log" nolabel="1" invisible="not l10n_bo_siat_log"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_l10n_bo_siat" model="ir.ui.view">
        <field name="name">account.out.invoice.list.l10n_bo_siat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_bo_siat_number" optional="show"/>
            </field>
            <field name="status_in_payment" position="before">
                <field name="l10n_bo_sale_doc" optional="hide"/>
                <field name="l10n_bo_siat_state" widget="badge" optional="show"
                       decoration-success="l10n_bo_siat_state == 'accepted'"
                       decoration-warning="l10n_bo_siat_state in ('to_send', 'cancel_requested')"
                       decoration-danger="l10n_bo_siat_state in ('rejected', 'cancelled')"
                       decoration-muted="l10n_bo_siat_state == 'not_applicable'"/>
                <field name="l10n_bo_siat_simulated" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_l10n_bo_siat" model="ir.ui.view">
        <field name="name">account.move.search.l10n_bo_siat</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="l10n_bo_siat_number"/>
                <field name="l10n_bo_siat_cuf"/>
                <field name="l10n_bo_sale_buyer_number"/>
            </field>
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="l10n_bo_siat_pending" string="SIAT: por registrar / enviar"
                        domain="[('l10n_bo_siat_state', 'in', ('to_send', 'rejected'))]"/>
                <filter name="l10n_bo_siat_accepted" string="SIAT: aceptadas"
                        domain="[('l10n_bo_siat_state', '=', 'accepted')]"/>
                <filter name="l10n_bo_siat_cancelled" string="SIAT: anuladas"
                        domain="[('l10n_bo_siat_state', 'in', ('cancel_requested', 'cancelled'))]"/>
                <filter name="l10n_bo_siat_simulated" string="SIAT: simuladas"
                        domain="[('l10n_bo_siat_simulated', '=', True)]"/>
                <filter name="l10n_bo_sale_no_invoice" string="Ventas sin factura"
                        domain="[('l10n_bo_sale_doc', '=', 'no_invoice')]"/>
                <group>
                    <filter name="group_l10n_bo_siat_state" string="Estado SIAT"
                            context="{'group_by': 'l10n_bo_siat_state'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Facturas con documento SIAT (bandeja de caja) -->
    <record id="action_l10n_bo_siat_invoices" model="ir.actions.act_window">
        <field name="name">Facturas SIAT</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('l10n_bo_sale_doc', '=', 'siat'), ('state', '=', 'posted')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_l10n_bo_siat_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay facturas pendientes de registro en el SIAT</p>
            <p>En la modalidad <b>Portal Web del SIN</b>, cada factura validada queda "Por registrar": emítala en el
               Portal Web y registre aquí el número y el CUF. En la modalidad <b>Proveedor</b> se envían solas y se
               reintentan automáticamente.</p>
        </field>
    </record>

    <!-- Control de ventas sin factura -->
    <record id="view_move_list_l10n_bo_sale_no_invoice" model="ir.ui.view">
        <field name="name">account.move.list.l10n_bo_sale_no_invoice</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Ventas sin factura" create="0" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                <field name="invoice_date"/>
                <field name="name"/>
                <field name="move_type" optional="hide"/>
                <field name="partner_id"/>
                <field name="l10n_bo_sale_no_invoice_reason"/>
                <field name="l10n_bo_sale_no_invoice_user_id" widget="many2one_avatar_user"/>
                <field name="invoice_user_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="amount_untaxed_signed" string="Sin impuestos" sum="Total"/>
                <field name="amount_tax_signed" string="Impuestos (IVA, IT)" sum="Total"/>
                <field name="amount_total_signed" string="Total" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_move_pivot_l10n_bo_sale_no_invoice" model="ir.ui.view">
        <field name="name">account.move.pivot.l10n_bo_sale_no_invoice</field>
        <field name="model">account.move</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Ventas sin factura">
                <field name="invoice_date" interval="month" type="row"/>
                <field name="amount_total_signed" type="measure"/>
                <field name="amount_tax_signed" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_l10n_bo_sale_no_invoice" model="ir.actions.act_window">
        <field name="name">Ventas sin factura</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_move_list_l10n_bo_sale_no_invoice')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_move_pivot_l10n_bo_sale_no_invoice')})]"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('l10n_bo_sale_doc', '=', 'no_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay ventas sin factura</p>
            <p>Ventas registradas sin factura del SIN (solo usuarios autorizados, con motivo y monto máximo). Se
               contabilizan con sus impuestos (IVA, IT). <b>Los casos en que la norma permite vender sin factura deben
               confirmarse con el contador.</b></p>
        </field>
    </record>
</odoo>
