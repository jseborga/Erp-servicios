<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_l10n_bo_siat" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_bo_siat</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="l10n_bo_siat_id_type" invisible="not vat"/>
                <field name="l10n_bo_siat_id_complement" invisible="not vat or l10n_bo_siat_id_type != '1'"/>
            </xpath>
        </field>
    </record>
</odoo>
