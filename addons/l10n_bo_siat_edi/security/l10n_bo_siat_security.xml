<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_l10n_bo_sale_no_invoice" model="res.groups.privilege">
        <field name="name">Ventas sin factura (Bolivia)</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="description">Permite registrar ventas sin factura del SIN (con motivo y monto máximo). Asignar solo a personal autorizado: los casos legales deben confirmarse con el contador.</field>
    </record>

    <record id="group_l10n_bo_sale_no_invoice" model="res.groups">
        <field name="name">Ventas sin factura (autorizado)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_l10n_bo_sale_no_invoice"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Puede validar ventas marcadas como "Venta sin factura" (motivo obligatorio, monto máximo por documento configurable). La venta y sus impuestos (IVA, IT) se registran igual en contabilidad.</field>
    </record>

    <data noupdate="1">
        <record id="l10n_bo_siat_provider_company_rule" model="ir.rule">
            <field name="name">Proveedores SIAT: multiempresa</field>
            <field name="model_id" ref="model_l10n_bo_siat_provider"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="l10n_bo_sale_book_company_rule" model="ir.rule">
            <field name="name">Libro de Ventas: multiempresa</field>
            <field name="model_id" ref="model_l10n_bo_sale_book"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
