<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_skill_view_list" model="ir.ui.view">
        <field name="name">spa.skill.list</field>
        <field name="model">spa.skill</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="employee_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="spa_skill_action" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">spa.skill</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
