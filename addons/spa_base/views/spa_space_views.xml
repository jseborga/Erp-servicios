<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_space_view_list" model="ir.ui.view">
        <field name="name">spa.space.list</field>
        <field name="model">spa.space</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="access_mode"/>
                <field name="open_hour" widget="float_time"/>
                <field name="close_hour" widget="float_time"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'maintenance'" decoration-danger="state == 'closed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="spa_space_view_form" model="ir.ui.view">
        <field name="name">spa.space.form</field>
        <field name="model">spa.space</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Piscina"/></h1>
                    </div>
                    <group>
                        <group string="Capacidad y acceso">
                            <field name="capacity"/>
                            <field name="access_mode" widget="radio"/>
                            <field name="slot_duration" widget="float_time" invisible="access_mode != 'slot'"/>
                            <field name="max_stay" widget="float_time" invisible="access_mode != 'free'"/>
                            <field name="analytic_account_id"/>
                            <field name="code"/>
                        </group>
                        <group string="Horario de funcionamiento">
                            <field name="open_hour" widget="float_time"/>
                            <field name="close_hour" widget="float_time"/>
                            <label for="open_mon" string="Días"/>
                            <div class="d-flex flex-wrap gap-2">
                                <span><field name="open_mon" nolabel="1"/> Lun</span>
                                <span><field name="open_tue" nolabel="1"/> Mar</span>
                                <span><field name="open_wed" nolabel="1"/> Mié</span>
                                <span><field name="open_thu" nolabel="1"/> Jue</span>
                                <span><field name="open_fri" nolabel="1"/> Vie</span>
                                <span><field name="open_sat" nolabel="1"/> Sáb</span>
                                <span><field name="open_sun" nolabel="1"/> Dom</span>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Servicios" name="services">
                            <field name="service_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="requires_staff"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cierres programados" name="closures">
                            <field name="closure_ids">
                                <list editable="bottom">
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="spa_space_action" model="ir.actions.act_window">
        <field name="name">Espacios</field>
        <field name="res_model">spa.space</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree el primer espacio</p>
            <p>Piscina, sauna, jacuzzi o cabina: cada espacio tiene su aforo, horario y modo de acceso.</p>
        </field>
    </record>
</odoo>
