<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_payment_offer_view_list" model="ir.ui.view">
        <field name="name">spa.payment.offer.list</field>
        <field name="model">spa.payment.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="offer_type"/>
                <field name="discount_percent" invisible="offer_type != 'discount'"/>
                <field name="installments" invisible="offer_type != 'installments'"/>
                <field name="months"/>
                <field name="plan_ids" widget="many2many_tags"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="new_members_only"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="spa_payment_offer_action" model="ir.actions.act_window">
        <field name="name">Ofertas de pago</field>
        <field name="res_model">spa.payment.offer</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
