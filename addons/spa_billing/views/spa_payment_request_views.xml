<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_payment_request_view_list" model="ir.ui.view">
        <field name="name">spa.payment.request.list</field>
        <field name="model">spa.payment.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'" decoration-info="state == 'pending'">
                <field name="create_date" string="Informado"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="method"/>
                <field name="channel" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-success="state == 'validated'" decoration-danger="state == 'rejected'"/>
                <button name="action_validate" type="object" string="Validar" class="btn-link" icon="fa-check"
                        invisible="state != 'pending'" groups="spa_base.group_spa_cashier"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="spa_payment_request_view_form" model="ir.ui.view">
        <field name="name">spa.payment.request.form</field>
        <field name="model">spa.payment.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validar pago" class="btn-primary"
                            invisible="state != 'pending' or not id" groups="spa_base.group_spa_cashier"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'pending' or not id" groups="spa_base.group_spa_cashier"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title" invisible="not id">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'pending'"/>
                            <field name="membership_id" readonly="state != 'pending'"/>
                            <field name="invoice_id" readonly="state != 'pending'" options="{'no_create': True}"/>
                            <field name="amount" readonly="state != 'pending'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="method" readonly="state != 'pending'"/>
                            <field name="reference" readonly="state != 'pending'"/>
                            <field name="receipt" filename="receipt_filename" readonly="state != 'pending'"/>
                            <field name="receipt_filename" invisible="1"/>
                            <field name="channel" readonly="state != 'pending'"/>
                            <field name="reject_reason" invisible="state == 'validated'" readonly="state != 'pending'"/>
                        </group>
                    </group>
                    <group invisible="state != 'validated'">
                        <field name="payment_id"/>
                        <field name="validated_by_id"/>
                        <field name="validated_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="spa_payment_request_view_search" model="ir.ui.view">
        <field name="name">spa.payment.request.search</field>
        <field name="model">spa.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="reference"/>
                <filter name="pending" string="Por validar" domain="[('state', '=', 'pending')]"/>
                <filter name="validated" string="Validados" domain="[('state', '=', 'validated')]"/>
                <group>
                    <filter name="group_method" string="Medio" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="spa_payment_request_action" model="ir.actions.act_window">
        <field name="name">Pagos por validar</field>
        <field name="res_model">spa.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pagos por validar</p>
            <p>Los comprobantes que envían los socios desde la web o que registra recepción aparecen aquí.</p>
        </field>
    </record>
</odoo>
