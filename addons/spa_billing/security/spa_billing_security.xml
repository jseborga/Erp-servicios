<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Caja registra cobros en contabilidad: implica facturación básica. -->
    <record id="spa_base.group_spa_cashier" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <data noupdate="1">
        <record id="spa_payment_request_company_rule" model="ir.rule">
            <field name="name">Pagos por validar: multiempresa</field>
            <field name="model_id" ref="model_spa_payment_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
