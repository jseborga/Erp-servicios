<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Caja registra cobros en contabilidad: implica facturación básica. Los asientos manuales quedan
         reservados al contador y al gerente (account.move.action_post, ver spa_billing/models/account_move.py). -->
    <record id="spa_base.group_spa_cashier" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <data noupdate="1">
        <record id="spa_payment_request_company_rule" model="ir.rule">
            <field name="name">Pagos por validar: multiempresa</field>
            <field name="model_id" ref="model_spa_payment_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_payment_offer_company_rule" model="ir.rule">
            <field name="name">Ofertas de pago: multiempresa</field>
            <field name="model_id" ref="model_spa_payment_offer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_deferral_line_company_rule" model="ir.rule">
            <field name="name">Devengo de membresías: multiempresa</field>
            <field name="model_id" ref="model_spa_deferral_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_dunning_step_company_rule" model="ir.rule">
            <field name="name">Escalera de cobranza: multiempresa</field>
            <field name="model_id" ref="model_spa_dunning_step"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_dunning_log_company_rule" model="ir.rule">
            <field name="name">Bitácora de cobranza: multiempresa</field>
            <field name="model_id" ref="model_spa_dunning_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
