<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Datos iniciales EDITABLES: carta de ejemplo, categorías del POS y lista pública -->
    <data noupdate="1">
        <record id="pos_category_cafe" model="pos.category">
            <field name="name">Cafetería</field>
            <field name="sequence">1</field>
        </record>
        <record id="pos_category_restaurant" model="pos.category">
            <field name="name">Restaurante</field>
            <field name="sequence">2</field>
        </record>

        <record id="product_coffee" model="product.product">
            <field name="name">Café americano</field>
            <field name="type">consu</field>
            <field name="list_price">15.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe')])]"/>
        </record>
        <record id="product_cappuccino" model="product.product">
            <field name="name">Capuchino</field>
            <field name="type">consu</field>
            <field name="list_price">20.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe')])]"/>
        </record>
        <record id="product_juice" model="product.product">
            <field name="name">Jugo natural</field>
            <field name="type">consu</field>
            <field name="list_price">18.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe'), ref('pos_category_restaurant')])]"/>
        </record>
        <record id="product_saltena" model="product.product">
            <field name="name">Salteña</field>
            <field name="type">consu</field>
            <field name="list_price">12.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe')])]"/>
        </record>
        <record id="product_salad" model="product.product">
            <field name="name">Ensalada de la casa</field>
            <field name="type">consu</field>
            <field name="list_price">45.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe'), ref('pos_category_restaurant')])]"/>
        </record>
        <record id="product_trout" model="product.product">
            <field name="name">Trucha a la plancha</field>
            <field name="type">consu</field>
            <field name="list_price">85.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_restaurant')])]"/>
        </record>
        <record id="product_pique_macho" model="product.product">
            <field name="name">Pique macho</field>
            <field name="type">consu</field>
            <field name="list_price">80.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_restaurant')])]"/>
        </record>
        <record id="product_water" model="product.product">
            <field name="name">Agua mineral</field>
            <field name="type">consu</field>
            <field name="list_price">10.0</field>
            <field name="categ_id" ref="l10n_bo_spa.categ_food_beverage"/>
            <field name="available_in_pos" eval="True"/>
            <field name="pos_categ_ids" eval="[(6, 0, [ref('pos_category_cafe'), ref('pos_category_restaurant')])]"/>
        </record>
    </data>
</odoo>
