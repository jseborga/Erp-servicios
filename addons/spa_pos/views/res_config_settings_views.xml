<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajustes del Punto de Venta: área analítica y precios de socio del punto de venta elegido -->
    <record id="res_config_settings_view_form_spa_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spa.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="Spa" id="spa_pos_section">
                    <setting id="spa_pos_analytic" string="Área analítica"
                             help="Las ventas y facturas de este punto de venta se registran en esta área (p. ej. Restaurante o Cafetería).">
                        <field name="pos_spa_analytic_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="spa_pos_member_pricing"
                             help="Agrega las listas de precios de los planes y rechaza al cobrar una lista de socio usada para quien no la tiene.">
                        <field name="pos_spa_member_pricing"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Ajustes del Spa: crear el Restaurante y la Cafetería en la compañía actual -->
    <record id="res_config_settings_view_form_spa_pos_setup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spa.pos.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="spa_base.res_config_settings_view_form_spa"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='spa_general']" position="after">
                <block title="Restaurante y cafetería" name="spa_pos">
                    <setting string="Puntos de venta del spa"
                             help="Crea en la compañía actual el Restaurante (8 mesas) y la Cafetería con Efectivo, QR / Transferencia y Cuenta del socio. No duplica lo que ya existe.">
                        <button name="action_spa_pos_setup" type="object" string="Crear Restaurante y Cafetería"
                                icon="oi-arrow-right" class="btn-link"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
