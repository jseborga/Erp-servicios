<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Lista de clientes: plan y estado del socio junto al nombre (verde = vigente). -->
    <t t-name="spa_pos.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-info')]//b" position="after">
            <span t-if="props.partner.spa_pos_member_label" class="badge rounded-pill ms-2 o_spa_member_badge"
                  t-att-class="props.partner.spa_pos_member_live ? 'text-bg-success' : 'text-bg-warning'"
                  t-esc="props.partner.spa_pos_member_label"/>
        </xpath>
        <xpath expr="//tr[hasclass('partner-line')]//b" position="after">
            <span t-if="props.partner.spa_pos_member_label" class="badge rounded-pill ms-2 o_spa_member_badge"
                  t-att-class="props.partner.spa_pos_member_live ? 'text-bg-success' : 'text-bg-warning'"
                  t-esc="props.partner.spa_pos_member_label"/>
        </xpath>
    </t>

    <!-- Botón de cliente de la orden: "Nombre · Plan · Estado". -->
    <t t-name="spa_pos.SelectPartnerButton" t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//div[@t-esc='props.partner.name']" position="attributes">
            <attribute name="t-esc">props.partner.spa_pos_member_label ? props.partner.name + ' · ' + props.partner.spa_pos_member_label : props.partner.name</attribute>
        </xpath>
    </t>

    <t t-name="spa_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('partner-name')]" position="inside">
            <t t-if="currentOrder.getPartner()?.spa_pos_member_label"
               t-esc="' · ' + currentOrder.getPartner().spa_pos_member_label"/>
        </xpath>
    </t>

</templates>
