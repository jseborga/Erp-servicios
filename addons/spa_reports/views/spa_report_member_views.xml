<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spa_report_member_view_list" model="ir.ui.view">
        <field name="name">spa.report.member.list</field>
        <field name="model">spa.report.member</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="days_overdue &gt; 30"
                  decoration-warning="days_overdue &gt; 0 and days_overdue &lt;= 30">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone" optional="show"/>
                <field name="plan_id"/>
                <field name="period_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'grace'"
                       decoration-danger="state == 'suspended'"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end"/>
                <field name="grace_until" optional="hide"/>
                <field name="mrr" sum="Total" optional="show"/>
                <field name="amount_due" sum="Total"/>
                <field name="amount_overdue" sum="Total" optional="show"/>
                <field name="oldest_due_date" optional="show"/>
                <field name="days_overdue"/>
                <field name="aging" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_membership" type="object" string="Abrir" icon="fa-external-link"
                        class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="spa_report_member_view_pivot" model="ir.ui.view">
        <field name="name">spa.report.member.pivot</field>
        <field name="model">spa.report.member</field>
        <field name="arch" type="xml">
            <pivot string="Socios y mora" display_quantity="1" sample="1">
                <field name="plan_id" type="row"/>
                <field name="state" type="col"/>
                <field name="mrr" type="measure"/>
                <field name="amount_due" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="spa_report_member_view_graph" model="ir.ui.view">
        <field name="name">spa.report.member.graph</field>
        <field name="model">spa.report.member</field>
        <field name="arch" type="xml">
            <graph string="Socios por plan y estado" type="bar" stacked="1" sample="1">
                <field name="plan_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="spa_report_member_view_search" model="ir.ui.view">
        <field name="name">spa.report.member.search</field>
        <field name="model">spa.report.member</field>
        <field name="arch" type="xml">
            <search string="Socios y mora">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="plan_id"/>
                <filter name="filter_live" string="Vigentes y suspendidos"
                        domain="[('state', 'in', ('active', 'grace', 'suspended'))]"/>
                <filter name="filter_active" string="Activos" domain="[('state', '=', 'active')]"/>
                <filter name="filter_grace" string="En gracia" domain="[('state', '=', 'grace')]"/>
                <filter name="filter_suspended" string="Suspendidos" domain="[('state', '=', 'suspended')]"/>
                <separator/>
                <filter name="filter_due" string="Con saldo por cobrar" domain="[('amount_due', '&gt;', 0)]"/>
                <filter name="filter_overdue" string="En mora" domain="[('days_overdue', '&gt;', 0)]"/>
                <separator/>
                <filter name="filter_date_end" string="Vencimiento" date="date_end"/>
                <group>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_aging" string="Antigüedad de la deuda" context="{'group_by': 'aging'}"/>
                    <filter name="group_date_end" string="Mes de vencimiento" context="{'group_by': 'date_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="spa_report_member_action" model="ir.actions.act_window">
        <field name="name">Socios y mora</field>
        <field name="res_model">spa.report.member</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="spa_report_member_view_search"/>
        <field name="context">{'search_default_filter_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Aún no hay socios</p>
            <p>Membresías por estado y plan con su ingreso mensual recurrente, saldo por cobrar y días de mora
               (desde el vencimiento de la factura impaga más antigua). Ordenado de mayor a menor mora.</p>
        </field>
    </record>
</odoo>
