<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multiempresa -->
        <record id="spa_rental_company_rule" model="ir.rule">
            <field name="name">Alquileres: multiempresa</field>
            <field name="model_id" ref="model_spa_rental"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_rental_line_company_rule" model="ir.rule">
            <field name="name">Líneas de alquiler: multiempresa</field>
            <field name="model_id" ref="model_spa_rental_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_class_template_company_rule" model="ir.rule">
            <field name="name">Horarios de clase: multiempresa</field>
            <field name="model_id" ref="model_spa_class_template"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_class_session_company_rule" model="ir.rule">
            <field name="name">Sesiones de clase: multiempresa</field>
            <field name="model_id" ref="model_spa_class_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="spa_class_enrollment_company_rule" model="ir.rule">
            <field name="name">Inscripciones a clases: multiempresa</field>
            <field name="model_id" ref="model_spa_class_enrollment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- El instructor ve sus sesiones y alumnos; recepción ve todo -->
        <record id="spa_class_session_reception_rule" model="ir.rule">
            <field name="name">Sesiones: recepción ve todas</field>
            <field name="model_id" ref="model_spa_class_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('spa_base.group_spa_reception'))]"/>
        </record>
        <record id="spa_class_session_instructor_rule" model="ir.rule">
            <field name="name">Sesiones: el instructor ve las suyas</field>
            <field name="model_id" ref="model_spa_class_session"/>
            <field name="domain_force">[('instructor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('spa_base.group_spa_therapist'))]"/>
        </record>
        <record id="spa_class_enrollment_reception_rule" model="ir.rule">
            <field name="name">Inscripciones: recepción ve todas</field>
            <field name="model_id" ref="model_spa_class_enrollment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('spa_base.group_spa_reception'))]"/>
        </record>
        <record id="spa_class_enrollment_instructor_rule" model="ir.rule">
            <field name="name">Inscripciones: el instructor ve las de sus sesiones</field>
            <field name="model_id" ref="model_spa_class_enrollment"/>
            <field name="domain_force">[('session_id.instructor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('spa_base.group_spa_therapist'))]"/>
        </record>
    </data>
</odoo>
