# Copie este archivo a .env (o péguelo en "Environment" de Easypanel)
# y cambie TODAS las contraseñas. No suba el .env al repositorio.

# PostgreSQL
DB_USER=odoo
DB_PASSWORD=cambie-esta-clave-de-base-de-datos

# Odoo
ODOO_DB=spa
# Contraseña maestra (gestión de bases de datos). Larga y aleatoria.
ODOO_ADMIN_PASSWD=cambie-esta-clave-maestra

# Primera instalación: crea la base y el usuario administrador.
ODOO_INIT=true
ODOO_INIT_LOGIN=admin
ODOO_INIT_PASSWORD=cambie-la-clave-del-administrador
ODOO_LANG=es_BO
ODOO_COUNTRY=BO
ODOO_INIT_MODULES=spa_all
# Servidor de DEMOSTRACIÓN (nunca en producción): ODOO_INIT_MODULES=spa_all,spa_demo
# crea un spa ficticio con seis semanas de operación y usuarios por rol con clave "demo".

# Al actualizar el código del módulo, ponga aquí los módulos a actualizar,
# redespliegue y luego déjelo vacío.
ODOO_UPDATE_MODULES=

# 0 = modo hilos (simple, adecuado para pocos usuarios). Con workers > 0 hay que
# enrutar /websocket al puerto 8072 en el proxy.
ODOO_WORKERS=0
ODOO_PROXY_MODE=True
